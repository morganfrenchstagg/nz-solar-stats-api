{
	"name": "nz-solar-stats-api",
	"description": "Estimates of New Zealand's distributed solar capacity, output and energy, per GXP.",
	"dependencies": {
		"chanfana": "2.8.3",
		"hono": "4.11.1",
		"zod": "3.25.67"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "0.21.3",
		"@types/node": "24.10.1",
		"@vitest/runner": "4.1.10",
		"@vitest/snapshot": "4.1.10",
		"typescript": "5.9.3",
		"vitest": "4.1.10",
		"wrangler": "4.136.1"
	},
	"private": true,
	"scripts": {
		"backtest": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/backtest.ts",
		"backtest:dispatch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/backtest-dispatch.ts",
		"backtest:pvoutput": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env scripts/backtest-pvoutput.ts",
		"cf-typegen": "wrangler types",
		"gxp-locations": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/gxp-locations.ts",
		"deploy": "wrangler deploy",
		"dev": "npm run seedLocalDb && wrangler dev",
		"predeploy": "wrangler d1 migrations apply DB --remote",
		"schema": "npx chanfana",
		"seedLocalDb": "wrangler d1 migrations apply DB --local",
		"test": "wrangler deploy --dry-run && npx vitest run --config tests/vitest.config.mts"
	}
}
