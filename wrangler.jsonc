{
	"compatibility_date": "2025-10-08",
	"main": "src/index.ts",
	"name": "nz-solar-stats-api",
	"upload_source_maps": true,
	"observability": {
		"enabled": true
	},
	"assets": {
		// Static pages, e.g. /forecast. Other paths fall through to the Worker.
		"directory": "./public"
	},
	"triggers": {
		// Daily at 6–7am NZ time, refreshing GXP solar capacity from EMI
		"crons": ["0 18 * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "openapi-template-db",
			"database_id": "3a12e8fb-6c1d-4b07-81de-5fb40db42cf3"
		}
	]
}
