{
	"compatibility_date": "2025-10-08",
	"main": "src/index.ts",
	"name": "nz-solar-stats-api",
	"upload_source_maps": true,
	"observability": {
		"enabled": true
	},
	"assets": {
		// Static pages, e.g. /forecast. Other paths fall through to the Worker.
		"directory": "./public"
	},
	"triggers": {
		// Daily at 6–7am NZ time, refreshing GXP solar capacity from EMI;
		// every 10 minutes, estimating solar output into DATASET; five minutes
		// after each of those, estimating past days again where anything's
		// changed and adding them up into energy; and twice a day (NZ night,
		// when the production job asks Open-Meteo for least), fetching a
		// fortnight of past weather to backfill from. src/schedule.ts has the
		// same strings, to tell them apart by and to cache responses until the
		// next one storing their data.
		"crons": ["0 18 * * *", "*/10 * * * *", "5,15,25,35,45,55 * * * *", "35 10,14 * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "openapi-template-db",
			"database_id": "3a12e8fb-6c1d-4b07-81de-5fb40db42cf3"
		}
	],
	"r2_buckets": [
		{
			// Each NZ date's solar production estimate, one JSON file per day;
			// past weather and the aggregates built from it (src/aggregates)
			"binding": "DATASET",
			"bucket_name": "nz-solar-stats-dataset"
		}
	]
}
